# TaskPilotAI – .gitignore

# ── Environment & Secrets ─────────────────────────────────────────────────────
backend/.env
*.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/
*.egg

# ── Node (if dev tooling is added later) ──────────────────────────────────────
node_modules/
npm-debug.log*

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo

# ── Build Artifacts ───────────────────────────────────────────────────────────
*.log
*.tmp
